<?xml version="1.0" encoding="UTF-8"?>
<!--
  CBR003 Inspections Due (Detailed), generated from a layout spec. Legacy's fields, labels and
  order (cbr-legacy jasper-server .../CBR003_InspectionsDueDetailed.rpt_jrxml), with its faults
  fixed:
  - Legacy sorted by forest district but printed none; each district now has a heading where it
    starts, repeated on each page it runs onto.
  - A structure's box could split across a page; it is now kept whole (the ROW group).
  - Labels ran through the column lines and into their values, and a long value was cut off; each
    label now has its own space, and every value wraps, the row growing with it.
  - Latitude and longitude print as degrees, minutes and seconds with their symbols, each part
    truncated, so neither 49.8 degrees rounds up to 50 nor a second reads 60.0.
  - What only a bridge has is blank for a culvert, where legacy printed "# Spans: 0".
  The rows come formatted from InspectionsDueRows; the ministry line is P_MINISTRY, the logo
  P_LOGO, and Date Printed P_DATE_PRINTED, in Pacific time.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="INSPECTIONS_DUE_DETAILED" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="576" leftMargin="18" rightMargin="18" topMargin="12" bottomMargin="12">
