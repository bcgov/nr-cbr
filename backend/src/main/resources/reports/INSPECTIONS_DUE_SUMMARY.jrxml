<?xml version="1.0" encoding="UTF-8"?>
<!--
  CBR004 Inspections Due (Summary), ported from legacy's JasperServer report
  (cbr-legacy jasper-server .../CBR004_InspectionsDueSummary.rpt_jrxml), its layout kept but for
  two faults. Legacy printed "Forest District:" in the page header from the page's first row, so a
  page that ran on into the next district labelled it wrongly; the district line and the column
  headings are now a group header, printed where each district starts and again on each page it
  continues onto. And every value was one fixed line - the Planned Inspection Comments two - so a
  long Road Name, Crossing Name or comment was cut off; each value now wraps, and the row's column
  lines grow with it - but a number or a date, which shrinks to fit its column instead. The title band, printed only for legacy's Excel export, is left out.

  As in the other reports, the port fills from rows rather than SQL - legacy called
  CBR_INSPCTNS_DUE_SUMMARY with a WHERE clause built as a string - every field already formatted
  as legacy's patterns printed it, but STRUCTURE_TYPE_CLASS_CODE, which the template abbreviates
  and the totals count. The ministry line (the CBR_HEADER subreport) is P_MINISTRY, the logo comes
  from the classpath through P_LOGO, and Date Printed is P_DATE_PRINTED, in Pacific time.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="INSPECTIONS_DUE_SUMMARY" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="768" leftMargin="12" rightMargin="12" topMargin="12" bottomMargin="12" uuid="0204ffad-3d73-4a46-b6a0-ff85128c1dc1">
