	<variable name="Permanent_Bridge_Count" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[( $F{STRUCTURE_TYPE_CLASS_CODE} != null && !($F{STRUCTURE_TYPE_CLASS_CODE}.isEmpty()) && $F{STRUCTURE_TYPE_CLASS_CODE}.equalsIgnoreCase( "PB" )
? 1
: 0
)]]></variableExpression>
